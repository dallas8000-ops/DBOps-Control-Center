DATABASE_URL=postgresql+psycopg2://dbops:dbops@localhost:5432/dbops
JWT_SECRET_KEY=change-me-minimum-32-characters-recommended
FRONTEND_ORIGINS=http://localhost:5173

# In-memory rate limits (per client IP). Set REDIS_URL for shared limits across replicas.
REDIS_URL=
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Prometheus metrics at GET /metrics (set METRICS_ENABLED=0 to disable)
METRICS_ENABLED=1

# Scheduled reports: optional retention purge (0 = disabled). Runs at start of each scheduler tick (leader only on Postgres).
REPORT_EXECUTION_LOG_RETENTION_DAYS=0

# Optional SMTP for schedule email delivery (stdlib only; use your own server or free mailbox + app password).
# If SMTP_HOST is unset, email delivery_kind stays log-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_TIMEOUT_SECONDS=20

# Example Gmail SMTP settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=youraddress@gmail.com
# SMTP_USE_TLS=1
# SMTP_TIMEOUT_SECONDS=20

# Render upgrade monitor (GET /admin/render-monitor; daily check in scheduler)
RENDER_CURRENT_COST=87
PROFIT_MULTIPLIER=3
ALERT_EMAIL=barney@gilliomfrontlinedigital.com
RENDER_MONITOR_INTERVAL_HOURS=24
# RENDER_MONITOR_DISABLE=1
# Optional overrides when Stripe MRR is tracked outside billing_settings:
# MONITOR_MRR_USD=261
# MONITOR_CLIENT_COUNT=6

# Stripe billing (required for /billing/checkout/session and /billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
# Optional: checkout page header (default DBOps Control Center)
STRIPE_CHECKOUT_DISPLAY_NAME=DBOps Control Center
VITE_API_URL=http://localhost:8000
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/oidc/callback

# Optional: Trello sync (scripts/trello_sync.py) — same key/token as Trello Viewer extension.
TRELLO_API_KEY=7fcc554eca7a3487655a3cecb3bfe5be
TRELLO_TOKEN=ATTA70d37271435f800e61b7aa69ed929c66e386ecfec0c4783f28bca065111be477A111C587
