# Production environment — set in Railway Variables (or Deployment-Stripe-center vault).
# Never commit real secrets. Run: python scripts/verify_automation_center_setup.py

NODE_ENV=production
APP_URL=https://dbops-api-production-5047.up.railway.app

# Core
JWT_SECRET_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/dbops?sslmode=require
FRONTEND_ORIGINS=https://dbops-api-production-5047.up.railway.app
VITE_API_URL=https://dbops-api-production-5047.up.railway.app

# Stripe — all three tiers for Growth/Scale readiness (tier_readiness on GET /health/billing)
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ID_STARTER=price_
STRIPE_PRICE_ID_PRO=price_
STRIPE_PRICE_ID_ENTERPRISE=price_
STRIPE_CHECKOUT_DISPLAY_NAME=DBOps Control Center

# Observability (Growth tier)
METRICS_ENABLED=1
METRICS_BEARER_TOKEN=

# Rate limits — optional REDIS_URL for multi-replica Scale deployments
REDIS_URL=
AUTH_RATE_LIMIT_MAX_REQUESTS=20
API_RATE_LIMIT_MAX_REQUESTS=120

# Railway hosting monitor (GET /admin/hosting-monitor)
RAILWAY_CURRENT_COST=20
PROFIT_MULTIPLIER=3
RAILWAY_MONITOR_INTERVAL_HOURS=24

# Optional Scale-tier features
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
