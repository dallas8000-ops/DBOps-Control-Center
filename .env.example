# Copy to .env in repo root for docker compose overrides (optional).
# JWT_SECRET_KEY=your-long-random-secret
# FRONTEND_ORIGINS=http://localhost:5173,https://dbops-api-production-5047.up.railway.app

# Optional: OIDC/SSO login. Set on API server. Verify: GET /health/oidc
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=                  # omit for public PKCE-only clients
# OIDC_DEFAULT_ROLE=Viewer             # role for auto-provisioned OIDC users

# Optional: Trello sync (scripts/trello_sync.py) — same key/token as Trello Viewer extension.
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=s7LuzRWy
